# URL del backend V2 para desarrollo local (npm run dev). El CORS de V2 acepta localhost:5173/5174.
VITE_API_URL=http://localhost:8080

# Solo en Vercel (variable de entorno del proyecto, OBLIGATORIA, no del build de Vite):
# URL del backend V2 al que reenvía el proxy api/[...path].js. Sin ella el proxy responde 500 backend_no_configurado.
# BACKEND_URL=https://tu-backend-v2.up.railway.app

# Pesos chilenos por 1 dólar para mostrar los costos de IA en pesos (referencial). Si no se define, se usa 950.
# En Vercel se define en Environment Variables y aplica en el próximo despliegue.
# VITE_DOLAR_CLP=950
